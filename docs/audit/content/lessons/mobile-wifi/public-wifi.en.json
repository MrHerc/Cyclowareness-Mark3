{
 "module": {
  "slug": "mobile-wifi",
  "title": "Mobile and Wi-Fi",
  "category": "devices"
 },
 "lesson": {
  "id": "public-wifi",
  "title": "Public Wi-Fi",
  "minutes": 3,
  "scenes": [
   {
    "type": "tutor",
    "id": "b-tutor",
    "beats": [
     {
      "id": "b-b1",
      "say": "Free Wi-Fi in cafes, airports and hotels is handy, but who set it up?",
      "mood": "talk",
      "gesture": "wave",
      "visual": {
       "kind": "illustration",
       "id": "wifi"
      }
     },
     {
      "id": "b-b2",
      "say": "An attacker can copy the cafe's network name exactly or closely. This is called an evil twin.",
      "mood": "alert",
      "gesture": "point-left",
      "visual": {
       "kind": "artifact",
       "artifact": {
        "kind": "wifi",
        "networks": [
         {
          "ssid": [
           {
            "text": "Cafe_Nargiz"
           }
          ],
          "secured": true,
          "signal": 3
         },
         {
          "ssid": [
           {
            "text": "Cafe_Nargiz_Free",
            "spot": "twin"
           }
          ],
          "secured": false,
          "signal": 4
         },
         {
          "ssid": [
           {
            "text": "Home-5G"
           }
          ],
          "secured": true,
          "signal": 1
         }
        ]
       }
      },
      "highlight": "twin"
     },
     {
      "id": "b-b3",
      "say": "A fake network may open a login page asking for your work password. Never type it for Wi-Fi.",
      "mood": "alert",
      "gesture": "point-down",
      "visual": {
       "kind": "artifact",
       "artifact": {
        "kind": "login",
        "brand": "Free Wi-Fi",
        "url": [
         {
          "text": "wifi-giris.test",
          "spot": "portal-url"
         }
        ],
        "fields": [
         "Work email",
         "Email password"
        ],
        "button": "Connect"
       }
      },
      "highlight": "portal-url"
     }
    ]
   },
   {
    "type": "simulation",
    "id": "cafe-twin",
    "environment": "phone",
    "title": "Cafe Wi-Fi",
    "intro": "You need to send a work email from a cafe. Which network do you join?",
    "steps": [
     {
      "id": "networks",
      "artifact": {
       "kind": "wifi",
       "networks": [
        {
         "ssid": [
          {
           "text": "Kafe_Nargiz"
          }
         ],
         "secured": true,
         "signal": 2
        },
        {
         "ssid": [
          {
           "text": "Kafe_Nargiz_Free"
          }
         ],
         "secured": false,
         "signal": 4
        },
        {
         "ssid": [
          {
           "text": "DIRECT-Printer"
          }
         ],
         "secured": true,
         "signal": 1
        }
       ]
      },
      "say": "Two similar names. One is open with a strong signal.",
      "actions": [
       {
        "id": "free",
        "label": "Join Kafe_Nargiz_Free",
        "kind": "connect",
        "outcome": "risky",
        "feedback": "An open, strong network with a similar name can be an evil twin. Ask staff for the exact name first.",
        "next": "portal"
       },
       {
        "id": "ask",
        "label": "Ask staff for the exact name",
        "kind": "verify",
        "outcome": "safe",
        "feedback": "Right. The cafe staff know the exact network name and password."
       },
       {
        "id": "mobile",
        "label": "Use mobile data instead",
        "kind": "disconnect",
        "outcome": "safe",
        "feedback": "Great choice. For important work, mobile data is safer than public Wi-Fi.",
        "next": "vpn"
       }
      ]
     },
     {
      "id": "staff-said",
      "label": "Staff: the network is Kafe_Nargiz, password at the till",
      "artifact": {
       "kind": "wifi",
       "networks": [
        {
         "ssid": [
          {
           "text": "Kafe_Nargiz"
          }
         ],
         "secured": true,
         "signal": 2
        },
        {
         "ssid": [
          {
           "text": "Kafe_Nargiz_Free"
          }
         ],
         "secured": false,
         "signal": 4
        }
       ]
      },
      "actions": [
       {
        "id": "real",
        "label": "Join Kafe_Nargiz",
        "kind": "connect",
        "outcome": "safe",
        "feedback": "Right. But even a name can be copied, so connect the VPN for work.",
        "next": "vpn"
       },
       {
        "id": "free",
        "label": "Join Kafe_Nargiz_Free",
        "kind": "connect",
        "outcome": "risky",
        "feedback": "Staff did not name this one. A strong signal is a typical evil twin trick."
       }
      ]
     },
     {
      "id": "portal",
      "label": "A sign-in page opened",
      "artifact": {
       "kind": "login",
       "brandRef": "kafe-nargiz-fake",
       "brand": "Kafe Nargiz Wi-Fi",
       "url": [
        {
         "text": "http://"
        },
        {
         "text": "kafe-nargiz-wifi.test",
         "spot": "portal"
        },
        {
         "text": "/giris"
        }
       ],
       "fields": [
        "Work email",
        "Password"
       ],
       "button": "Get online"
      },
      "say": "The Wi-Fi page wants your work password.",
      "actions": [
       {
        "id": "login",
        "label": "Get online",
        "kind": "enter-credentials",
        "outcome": "compromised",
        "feedback": "Wi-Fi never needs your work password. Change it now from another device and report it."
       },
       {
        "id": "leave",
        "label": "Close and leave the network",
        "kind": "disconnect",
        "outcome": "safe",
        "feedback": "Right: a Wi-Fi page asking for your work password is fake. Forget the network."
       }
      ]
     },
     {
      "id": "vpn",
      "artifact": {
       "kind": "dialog",
       "brandRef": "agentlik-vpn",
       "tone": "app",
       "title": [
        {
         "text": "VPN not connected"
        }
       ],
       "body": [
        [
         {
          "text": "Your organisation requires the VPN to open work email."
         }
        ]
       ],
       "buttons": [
        "Connect VPN",
        "Continue without VPN"
       ]
      },
      "actions": [
       {
        "id": "vpn",
        "label": "Connect VPN",
        "kind": "connect",
        "outcome": "safe",
        "feedback": "Right. The VPN sends data through an encrypted tunnel, even on a fake network."
       },
       {
        "id": "skip",
        "label": "Continue without VPN",
        "kind": "ignore",
        "outcome": "risky",
        "feedback": "Even a quick task is risky. If your organisation requires a VPN, always connect it first."
       }
      ]
     }
    ]
   },
   {
    "type": "hotspot",
    "id": "b-hotspot",
    "prompt": "You are at the airport. Find the suspicious networks.",
    "artifact": {
     "kind": "wifi",
     "networks": [
      {
       "ssid": [
        {
         "text": "Terminal-WiFi"
        }
       ],
       "secured": false,
       "signal": 3
      },
      {
       "ssid": [
        {
         "text": "Terminal_WiFi",
         "spot": "lookalike"
        }
       ],
       "secured": false,
       "signal": 4
      },
      {
       "ssid": [
        {
         "text": "Free_Fast_Internet",
         "spot": "bait-name"
        }
       ],
       "secured": false,
       "signal": 4
      },
      {
       "ssid": [
        {
         "text": "Terminal-WiFi-VIP",
         "spot": "vip"
        }
       ],
       "secured": false,
       "signal": 4
      },
      {
       "ssid": [
        {
         "text": "Cafe-Guest"
        }
       ],
       "secured": true,
       "signal": 2
      }
     ]
    },
    "spots": [
     {
      "id": "lookalike",
      "label": "Almost the official name",
      "explain": "A one character difference is a sign of an evil twin. A fake can even copy the exact name, so use a VPN for important work."
     },
     {
      "id": "bait-name",
      "label": "Tempting name",
      "explain": "A very tempting name is bait. No one knows who set this network up."
     },
     {
      "id": "vip",
      "label": "Made up VIP network",
      "explain": "An extra network that is not on the official sign may be fake."
     }
    ],
    "minToFind": 2
   },
   {
    "type": "swipe",
    "id": "b-swipe",
    "prompt": "Fine to connect, or a risk?",
    "cards": [
     {
      "id": "open-unknown",
      "artifact": {
       "kind": "wifi",
       "networks": [
        {
         "ssid": [
          {
           "text": "Free_WiFi_Fast"
          }
         ],
         "secured": false,
         "signal": 4
        }
       ]
      },
      "verdict": "threat",
      "explain": "An open network set up by who knows whom. Use mobile data for important tasks."
     },
     {
      "id": "own-hotspot",
      "artifact": {
       "kind": "wifi",
       "networks": [
        {
         "ssid": [
          {
           "text": "My phone"
          }
         ],
         "secured": true,
         "signal": 4
        }
       ]
      },
      "verdict": "safe",
      "explain": "Your own phone's password protected hotspot. It is safer than a public network."
     },
     {
      "id": "portal-password",
      "artifact": {
       "kind": "login",
       "brand": "Free Wi-Fi",
       "url": [
        {
         "text": "free-wifi-giris.test"
        }
       ],
       "fields": [
        "Work email",
        "Password"
       ],
       "button": "Connect"
      },
      "verdict": "threat",
      "explain": "Wi-Fi never needs your work password. This is a fake page that steals it."
     },
     {
      "id": "hotel-room",
      "artifact": {
       "kind": "login",
       "brandRef": "qala-otel",
       "brand": "Qala Hotel guest Wi-Fi",
       "url": [
        {
         "text": "wifi.otel-qala.test"
        }
       ],
       "fields": [
        "Room number",
        "Surname"
       ],
       "button": "Connect"
      },
      "verdict": "safe",
      "explain": "Many hotels ask only for a room number and surname, and the address carries the hotel's name. No password or card is asked. Confirm the network with reception and use the VPN for work."
     },
     {
      "id": "wifi-card",
      "artifact": {
       "kind": "sms",
       "sender": [
        {
         "text": "WiFi-Xidmet"
        }
       ],
       "time": "17:40",
       "messages": [
        [
         {
          "text": "Your free internet package is ending. Enter your card details to extend: "
         },
         {
          "text": "wifi-paket.test"
         }
        ]
       ]
      },
      "verdict": "threat",
      "explain": "Free internet does not need your card details. This is an attempt to steal them."
     }
    ]
   },
   {
    "type": "choice",
    "id": "b-choice-vpn",
    "question": {
     "prompt": "You need your work email in a cafe, and your organisation requires a VPN.",
     "options": [
      {
       "id": "vpn-first",
       "label": "I switch on the VPN first, then open email",
       "correct": true,
       "feedback": "Correct. The VPN carries your work data through an encrypted channel."
      },
      {
       "id": "quick-no-vpn",
       "label": "It is quick, I go without the VPN",
       "correct": false,
       "feedback": "The rule applies to quick tasks too. A fake network waits for exactly these moments."
      },
      {
       "id": "personal-mail",
       "label": "I forward the files to my personal email",
       "correct": false,
       "feedback": "Sending work data to personal email can break the rules and leave the data unprotected."
      }
     ]
    },
    "explain": "The VPN rule is there for a reason. It protects your work data even on an open network."
   },
   {
    "type": "recap",
    "id": "b-recap",
    "points": [
     "Get the exact network name from staff",
     "Never type your work password for Wi-Fi",
     "Mobile data or a VPN for important work"
    ],
    "mood": "celebrate"
   }
  ]
 },
 "nextLesson": {
  "id": "lost-phone",
  "title": "Lost phone"
 },
