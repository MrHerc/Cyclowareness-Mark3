# Values of the Docker demo stack (docker-compose.demo.yml). Copy this file to .env.demo (gitignored), set
# the three values and start the stack from the repository root:
#
#   docker compose --env-file portal/.env.demo -f portal/docker-compose.demo.yml up --build
#
# None has a default: the stack refuses to start until all three are set. Pick fresh random values; the
# stack is throwaway, but a value committed to a public repository would open every demo account.

# Password of the stack's PostgreSQL user "portal": letters and digits only, it is spliced into a URL
# (postgres://portal:<value>@db), for example `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# 32 or more random characters, for example `openssl rand -base64 48`.
APP_SECRET=
# Password of every demo account (12 or more characters), admin@safarovindustries.com included.
SEED_PASSWORD=
