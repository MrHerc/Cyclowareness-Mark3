# Copy to .env.local for local development, or set these in your deployment.
# src/server/env.ts validates every value at start-up; an empty value counts as "not set".

# Public base URL (used in emails, SMS, certificate links, phishing simulations and sign-in redirects).
# Production refuses to start when it is unset, plain http:// or a loopback host (localhost, 127.0.0.1):
# set the public https:// address. ALLOW_HTTP_APP_URL=1 accepts http:// or loopback for an intranet or
# local test stack only.
APP_URL=http://localhost:3000
ALLOW_HTTP_APP_URL=

# 32+ random characters. Encrypts stored secrets (SMTP, SSO, TOTP keys, webhook secrets).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# PostgreSQL connection string. Leave empty locally to use the embedded database in .data/pg.
# Production refuses to start without it (ALLOW_EMBEDDED_DB=1 allows the embedded database for a
# single-process demo only).
DATABASE_URL=
# node-postgres pool size, 2-100 (the job runner keeps one connection for its lock).
DATABASE_POOL_MAX=10
ALLOW_EMBEDDED_DB=

# First start of a new installation: creates the platform operator (operator console /super) and
# prints a one-time invitation link to the server log. Ignored once an operator exists.
BOOTSTRAP_OPERATOR_EMAIL=

# AI tutor (Claude). Without a key the tutor answers from the lesson content only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Text messages for phone sign-in and SMS simulations: "webhook" posts {to, text} to SMS_WEBHOOK_URL
# (required with it), with SMS_WEBHOOK_TOKEN as a bearer token.
SMS_PROVIDER=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Telephony provider for voice-call simulations. Without one, voice campaigns cannot launch in production.
VOICE_PROVIDER=

# Development only: show one-time sign-in codes on screen instead of sending SMS.
DEV_SHOW_OTP=1

# Background jobs (reminders, scheduled campaigns, report emails, mail retries, webhooks).
# 0 on servers that should not run them; then run `npm run jobs` (or the compose "worker").
# The worker needs DATABASE_URL (PostgreSQL): the embedded database is single-process, so with it
# keep JOBS_ENABLED=1.
JOBS_ENABLED=1

# Number of reverse proxies in front of the server that append to X-Forwarded-For (0 = none, the
# headers are ignored; 1 = one nginx/Caddy/Traefik). The client address is taken that many entries
# from the right, so a value the client sends itself is never trusted. Production behind a proxy
# must set it: with 0 the sign-in lockout per address and audit IPs are off, and the public demo
# form can only limit per email (beyond 100 anonymous requests an hour it still stores requests
# for the operator console but stops emailing SALES_EMAIL).
TRUST_PROXY=0
# x-real-ip only when the proxy overwrites that header with the peer address (nginx:
# proxy_set_header X-Real-IP $remote_addr;). Default: x-forwarded-for.
CLIENT_IP_HEADER=

# Strict-Transport-Security is sent in production with max-age=2 years. These add every subdomain
# of the domain and the preload flag: only when the whole domain is served over HTTPS for good.
HSTS_INCLUDE_SUBDOMAINS=0
HSTS_PRELOAD=0

# Password for every demo account created by `npm run db:seed` (see README for the accounts).
SEED_PASSWORD=Portal-Demo-2026!
# The seed empties every table. It runs against DATABASE_URL (or with NODE_ENV=production) only
# with ALLOW_SEED=1, and only on a fresh or throwaway database.
ALLOW_SEED=

# Demo requests from the public site are emailed here (optional; they are always stored for the
# operator console). Needs the platform mail server below.
SALES_EMAIL=
# Mail server for platform mail that belongs to no organisation. PLATFORM_SMTP_SECURE=1 for implicit
# TLS (port 465); otherwise STARTTLS is required. PLATFORM_MAIL_FROM is required with a host.
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURE=0
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASSWORD=
PLATFORM_MAIL_FROM=
