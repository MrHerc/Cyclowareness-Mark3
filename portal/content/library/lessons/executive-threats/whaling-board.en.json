{
 "id": "whaling-board",
 "title": "Whaling",
 "minutes": 3,
 "scenes": [
  {
   "type": "tutor",
   "id": "intro",
   "beats": [
    {
     "id": "b1",
     "say": "A fake leader email often comes in the name of a deputy minister or the board secretariat.",
     "mood": "talk",
     "gesture": "wave",
     "visual": {
      "kind": "illustration",
      "id": "ceo"
     }
    },
    {
     "id": "b2",
     "say": "The name is familiar, but check the address: the domain is not yours, a word or letter differs.",
     "mood": "alert",
     "gesture": "point-left",
     "visual": {
      "kind": "artifact",
      "artifact": {
       "kind": "email",
       "brandRef": "idare-fake",
       "from": {
        "name": [
         {
          "text": "Saadat Mammadli"
         }
        ],
        "address": [
         {
          "text": "r.mammadli@"
         },
         {
          "text": "idare-gov.example.net",
          "spot": "domain"
         }
        ]
       },
       "subject": [
        {
         "text": "Confidential: must be done today"
        }
       ],
       "time": "09:12",
       "body": [
        [
         {
          "text": "Hello. "
         },
         {
          "text": "I am in a meeting and cannot call.",
          "spot": "no-call"
         }
        ],
        [
         {
          "text": "An advance payment to a partner must go out today, the details are attached."
         }
        ],
        [
         {
          "text": "This is confidential, do not discuss it with anyone.",
          "spot": "secret"
         }
        ],
        [
         {
          "text": "Saadat Mammadli, Deputy Minister"
         }
        ]
       ],
       "attachments": [
        {
         "name": [
          {
           "text": "Rekvizitler.pdf"
          }
         ],
         "size": "88 KB"
        }
       ]
      }
     },
     "highlight": "domain"
    },
    {
     "id": "b3",
     "say": "Urgency, secrecy and \"I cannot call\" are there to keep you from checking.",
     "mood": "think",
     "gesture": "lean-in",
     "visual": {
      "kind": "artifact",
      "artifact": {
       "kind": "email",
       "brandRef": "idare-fake",
       "from": {
        "name": [
         {
          "text": "Saadat Mammadli"
         }
        ],
        "address": [
         {
          "text": "r.mammadli@"
         },
         {
          "text": "idare-gov.example.net",
          "spot": "domain"
         }
        ]
       },
       "subject": [
        {
         "text": "Confidential: must be done today"
        }
       ],
       "time": "09:12",
       "body": [
        [
         {
          "text": "Hello. "
         },
         {
          "text": "I am in a meeting and cannot call.",
          "spot": "no-call"
         }
        ],
        [
         {
          "text": "An advance payment to a partner must go out today, the details are attached."
         }
        ],
        [
         {
          "text": "This is confidential, do not discuss it with anyone.",
          "spot": "secret"
         }
        ],
        [
         {
          "text": "Saadat Mammadli, Deputy Minister"
         }
        ]
       ],
       "attachments": [
        {
         "name": [
          {
           "text": "Rekvizitler.pdf"
          }
         ],
         "size": "88 KB"
        }
       ]
      }
     },
     "highlight": "no-call"
    },
    {
     "id": "b4",
     "say": "The rule is simple: check a senior request on a number you know or in person, never by reply.",
     "mood": "happy",
     "gesture": "shield-up",
     "visual": {
      "kind": "illustration",
      "id": "handshake"
     }
    }
   ]
  },
  {
   "type": "simulation",
   "id": "board-inbox",
   "environment": "inbox",
   "title": "Leadership mail",
   "intro": "Four emails from leadership are in your inbox. Open each: which are real and which are fake?",
   "steps": [
    {
     "id": "fake-deputy",
     "artifact": {
      "kind": "email",
      "brandRef": "idare-fake",
      "from": {
       "name": [
        {
         "text": "Saadat Mammadli"
        }
       ],
       "address": [
        {
         "text": "r.mammadli@"
        },
        {
         "text": "idare-gov.example.net",
         "spot": "domain"
        }
       ]
      },
      "subject": [
       {
        "text": "Confidential: must be done today"
       }
      ],
      "time": "09:12",
      "body": [
       [
        {
         "text": "Hello. "
        },
        {
         "text": "I am in a meeting and cannot call.",
         "spot": "no-call"
        }
       ],
       [
        {
         "text": "An advance payment to a partner must go out today, the details are attached."
        }
       ],
       [
        {
         "text": "This is confidential, do not discuss it with anyone.",
         "spot": "secret"
        }
       ],
       [
        {
         "text": "Saadat Mammadli, Deputy Minister"
        }
       ]
      ],
      "attachments": [
       {
        "name": [
         {
          "text": "Rekvizitler.pdf"
         }
        ],
        "size": "88 KB"
       }
      ]
     },
     "say": "Read the domain to the end.",
     "actions": [
      {
       "id": "report",
       "label": "Report as phishing",
       "kind": "report",
       "outcome": "safe",
       "feedback": "Correct. The domain is not yours, plus urgency, secrecy and avoiding a call."
      },
      {
       "id": "reply",
       "label": "Reply: on it",
       "kind": "reply",
       "outcome": "compromised",
       "feedback": "Your reply goes straight to the attacker. Always check a money request on a number you know."
      },
      {
       "id": "attachment",
       "label": "Open the attachment",
       "kind": "open-attachment",
       "outcome": "risky",
       "feedback": "The attachment may hold malware or fake bank details. Check the sender first."
      }
     ]
    },
    {
     "id": "real-deputy",
     "artifact": {
      "kind": "email",
      "brandRef": "idare",
      "from": {
       "name": [
        {
         "text": "Saadat Mammadli"
        }
       ],
       "address": [
        {
         "text": "r.mammadli@idare.example"
        }
       ]
      },
      "subject": [
       {
        "text": "Friday's board meeting"
       }
      ],
      "time": "10:05",
      "body": [
       [
        {
         "text": "Dear colleagues, the board meeting is on Friday at 11:00."
        }
       ],
       [
        {
         "text": "The agenda is in the internal document system. Send your slides by Thursday."
        }
       ]
      ]
     },
     "actions": [
      {
       "id": "safe",
       "label": "Mark as safe",
       "kind": "mark-safe",
       "outcome": "safe",
       "feedback": "Correct: your domain, an expected topic, no money or password request."
      },
      {
       "id": "reply",
       "label": "Reply",
       "kind": "reply",
       "outcome": "safe",
       "feedback": "It is an ordinary work email, replying is safe."
      },
      {
       "id": "report",
       "label": "Report as phishing",
       "kind": "report",
       "outcome": "risky",
       "feedback": "Caution is good, but this one is real: your domain and nothing is asked."
      }
     ]
    },
    {
     "id": "fake-board",
     "artifact": {
      "kind": "email",
      "brandRef": "idare-fake",
      "from": {
       "name": [
        {
         "text": "Board secretariat"
        }
       ],
       "address": [
        {
         "text": "katiblik@board-idare.example.net"
        }
       ]
      },
      "subject": [
       {
        "text": "Vote by 18:00 today"
       }
      ],
      "time": "11:30",
      "body": [
       [
        {
         "text": "Dear board member, please vote on an urgent draft decision."
        }
       ],
       [
        {
         "text": "Sign in with your work account: "
        },
        {
         "text": "board-idare.example.net/sesverme",
         "link": {
          "label": "board-idare.example.net/sesverme",
          "href": "https://board-idare.example.net/sesverme"
         }
        }
       ]
      ]
     },
     "actions": [
      {
       "id": "report",
       "label": "Report as phishing",
       "kind": "report",
       "outcome": "safe",
       "feedback": "Correct. The domain is not yours and an outside site wants your work password."
      },
      {
       "id": "click",
       "label": "Open the link",
       "kind": "click-link",
       "outcome": "compromised",
       "feedback": "This is a fake portal that steals work passwords. Real votes happen in the internal system."
      },
      {
       "id": "forward",
       "label": "Forward to my assistant",
       "kind": "forward",
       "outcome": "risky",
       "feedback": "Forwarding passes the danger to your assistant. Report it as phishing."
      }
     ]
    },
    {
     "id": "assistant-schedule",
     "artifact": {
      "kind": "email",
      "brandRef": "idare",
      "from": {
       "name": [
        {
         "text": "Səbinə Əliyeva"
        }
       ],
       "address": [
        {
         "text": "s.aliyeva@idare.example"
        }
       ]
      },
      "subject": [
       {
        "text": "Tomorrow's schedule"
       }
      ],
      "time": "12:10",
      "body": [
       [
        {
         "text": "Tomorrow's schedule is attached. The 15:00 meeting moved to the second floor."
        }
       ]
      ],
      "attachments": [
       {
        "name": [
         {
          "text": "Cedvel.pdf"
         }
        ],
        "size": "64 KB"
       }
      ]
     },
     "actions": [
      {
       "id": "open",
       "label": "Open the attachment",
       "kind": "open-attachment",
       "outcome": "safe",
       "feedback": "Correct. An expected sender, your domain and an ordinary PDF."
      },
      {
       "id": "report",
       "label": "Report as phishing",
       "kind": "report",
       "outcome": "risky",
       "feedback": "This is your assistant's routine email. Doubting everything slows work down."
      }
     ]
    }
   ]
  },
  {
   "type": "choice",
   "id": "verify-right-way",
   "question": {
    "prompt": "A money request came from the deputy. How do you check it?",
    "options": [
     {
      "id": "mail-number",
      "label": "I call the number in the email",
      "correct": false,
      "feedback": "That number is the attacker's, and he will say \"yes\"."
     },
     {
      "id": "reply",
      "label": "I reply to the email and ask",
      "correct": false,
      "feedback": "The reply goes to the attacker, who will confirm the request."
     },
     {
      "id": "known",
      "label": "I call the number in the phone book or ask the assistant",
      "correct": true,
      "feedback": "Correct. A channel you know is not under the attacker's control."
     }
    ],
    "visual": {
     "kind": "illustration",
     "id": "ceo"
    }
   },
   "explain": "Always check outside the email, on a channel you know."
  },
  {
   "type": "match",
   "id": "red-flags",
   "prompt": "Match each sign with what it means.",
   "pairs": [
    {
     "id": "domain",
     "left": "An outside domain",
     "right": "The email is not from your organisation"
    },
    {
     "id": "secret",
     "left": "\"Tell nobody\"",
     "right": "Cuts you off from checking"
    },
    {
     "id": "no-call",
     "left": "\"I cannot call\"",
     "right": "Avoids a voice check"
    },
    {
     "id": "deadline",
     "left": "\"By 18:00 today\"",
     "right": "Leaves no time to think"
    }
   ],
   "explain": "One sign is enough to stop and check."
  },
  {
   "type": "swipe",
   "id": "board-swipe",
   "prompt": "Real or fake request?",
   "cards": [
    {
     "id": "new-number",
     "artifact": {
      "kind": "chat",
      "app": "whatsapp",
      "contact": [
       {
        "text": "Saadat Mammadli (new number)"
       }
      ],
      "messages": [
       {
        "from": "them",
        "body": [
         {
          "text": "This is my new number. I am in a meeting, do not tell my assistant, I have a task for you."
         }
        ],
        "time": "14:02"
       }
      ]
     },
     "verdict": "threat",
     "explain": "A new number and a demand for secrecy. Call the old number to check."
    },
    {
     "id": "doc-system",
     "artifact": {
      "kind": "email",
      "brandRef": "idare",
      "from": {
       "name": [
        {
         "text": "Internal document system"
        }
       ],
       "address": [
        {
         "text": "edoc@idare.example"
        }
       ]
      },
      "subject": [
       {
        "text": "A protocol awaits your signature"
       }
      ],
      "time": "15:20",
      "body": [
       [
        {
         "text": "The board protocol awaits your signature. Sign in through the organisation's portal."
        }
       ]
      ]
     },
     "verdict": "safe",
     "explain": "No link, it sends you to the official portal. An expected workflow."
    },
    {
     "id": "fake-protocol",
     "artifact": {
      "kind": "email",
      "brandRef": "idare-fake",
      "from": {
       "name": [
        {
         "text": "Board secretariat"
        }
       ],
       "address": [
        {
         "text": "kollegiya@idare-gov.example.net"
        }
       ]
      },
      "subject": [
       {
        "text": "Sign the protocol urgently"
       }
      ],
      "time": "16:45",
      "body": [
       [
        {
         "text": "Sign the protocol today: "
        },
        {
         "text": "idare-gov.example.net/imza",
         "link": {
          "label": "idare-gov.example.net/imza",
          "href": "https://idare-gov.example.net/imza"
         }
        }
       ]
      ]
     },
     "verdict": "threat",
     "explain": "The domain is not yours and there is an urgent link. Report it as phishing."
    }
   ]
  },
  {
   "type": "recap",
   "id": "recap",
   "points": [
    "A leader's name is no proof, check the domain and the request.",
    "Confirm money and password requests on a channel you know.",
    "Do not reply to a fake email, report it."
   ],
   "mood": "celebrate"
  }
 ]
}