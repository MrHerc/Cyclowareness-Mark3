  {
   "type": "choice",
   "id": "first-move",
   "question": {
    "prompt": "What do you do with a suspicious email?",
    "options": [
     {
      "id": "report",
      "label": "I press the Report phishing button",
      "correct": true,
      "feedback": "Right. No such button? Forward the email to your IT security contact. The team can then block it for everyone."
     },
     {
      "id": "click",
      "label": "I open the link to check",
      "correct": false,
      "feedback": "One click can open a harmful page. Check the address instead."
     },
     {
      "id": "reply",
      "label": "I reply and ask the sender",
      "correct": false,
      "feedback": "Your reply goes straight to the scammer. Of course they will say it is fine."
     },
     {
      "id": "forward",
      "label": "I forward it to colleagues to look at",
      "correct": false,
      "feedback": "That spreads the danger. Report it and the team will look."
     }
    ]
   },
   "explain": "Reporting protects you and your colleagues. If your mail has no Report phishing button, forward the email to IT security."
