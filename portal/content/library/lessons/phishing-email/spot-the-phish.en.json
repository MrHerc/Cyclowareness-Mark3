    {
     "id": "sender-domain",
     "label": "Unknown domain",
     "explain": "An official service does not write from an address like this. The name is made up to look official."
    },
    {
     "id": "greeting",
     "label": "Generic greeting",
     "explain": "A real notice usually shows your name and a case number."
    },
    {
     "id": "threat",
     "label": "Threat and deadline",
     "explain": "Fear and a short deadline push you to pay without checking."
    },
    {
