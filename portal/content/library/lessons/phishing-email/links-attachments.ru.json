          "verdict": "safe",
          "explain": "Часть portal в начале — собственный раздел агентства. Окончание по-прежнему xidmetagentliyi.az."
        },
        {
          "id": "decoy",
          "artifact": {
            "kind": "url",
            "brandRef": "xidmet-agentliyi-fake",
            "url": [
              {
                "text": "https://xidmetagentliyi.az-portal.info/giris"
              }
