          {
            "id": "scan-pay",
            "label": "Отсканирую и сразу оплачу",
            "correct": false,
            "feedback": "Поддельная страница может украсть данные вашей карты."
          },
          {
            "id": "official",
            "label": "Проверю штраф на официальном портале",
            "correct": true,
            "feedback": "Верно. Если штраф настоящий, он там будет."
          },
          {
            "id": "call-number",
            "label": "Позвоню по номеру из уведомления",
